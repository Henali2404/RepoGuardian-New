GEMINI_API_KEY_1=your-gemini-key
GEMINI_API_KEY_2=your-gemini-key
GEMINI_API_KEY_3=your-gemini-key
GEMINI_API_KEY_4=your-gemini-key
GEMINI_API_KEY_5=your-gemini-key
GITHUB_TOKEN=your-github-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
FRONTEND_URL=http://localhost:3000

# LLM performance tuning (all optional)
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=128
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=180
GEMINI_MAX_RETRY_DELAY_SECONDS=8
AUDITOR_PARALLEL_SECURITY=true

# (Optional) Service Account Configuration:
# Place service_account.json in the backend/ directory or set one of the variables below:
# GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# GEMINI_SERVICE_ACCOUNT_JSON=service_account.json
